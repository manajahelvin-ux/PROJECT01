# ==========================================
# DataExtract AI - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Django Core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database ---
# SQLite for development:
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL for production (uncomment and configure):
# DATABASE_URL=postgres://user:password@localhost:5432/dataextract_ai

# --- Redis (Celery broker & result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- OpenRouter AI ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TIMEOUT=60

# --- Playwright ---
PLAYWRIGHT_ENABLED=True
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_HEADLESS=True

# --- Scraping Defaults ---
DEFAULT_REQUEST_DELAY_SECONDS=2
MAX_CONCURRENT_REQUESTS_PER_DOMAIN=2
MAX_PAGES_PER_EXTRACTION=100
MAX_RESPONSE_SIZE_KB=5120
USER_AGENT_ROTATION=True

# --- Data Retention ---
DATA_RETENTION_DAYS=365

# --- Monitoring / Error Tracking ---
SENTRY_DSN=

# --- Email (for password reset, notifications) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
