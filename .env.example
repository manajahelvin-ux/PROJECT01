# ============================================================================
# TRANSCRIBE AI - Configuration d'environnement (modele)
# Copier ce fichier vers .env puis renseigner les valeurs.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# NE JAMAIS COMMITTER LE FICHIER .env
# ============================================================================

# --- OpenRouter (obligatoire pour le traitement IA) ------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# En-tetes de courtoisie recommandes par OpenRouter (classement/attribution)
OPENROUTER_APP_NAME=TranscribeAI
OPENROUTER_SITE_URL=https://github.com/manajahelvin-ux/PROJECT01

# --- Parametres d'inference ------------------------------------------------
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_TIMEOUT=120
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF=2.0

# --- Chunking intelligent --------------------------------------------------
# Taille cible d'un bloc envoye a l'IA (en caracteres) et recouvrement
CHUNK_SIZE=6000
CHUNK_OVERLAP=200

# --- Moteur de transcription ----------------------------------------------
# whisper | faster-whisper | openai-api (extensible)
TRANSCRIPTION_ENGINE=faster-whisper
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
DEFAULT_LANGUAGE=auto

# --- Binaires externes (laisser vide = detection automatique dans le PATH) --
FFMPEG_PATH=
FFPROBE_PATH=

# --- Stockage --------------------------------------------------------------
# Laisser vide = dossier utilisateur (%APPDATA%/TranscribeAI ou ~/.transcribe_ai)
DATA_DIR=
DATABASE_URL=

# --- Interface -------------------------------------------------------------
# dark | light | system
UI_THEME=dark
UI_LANGUAGE=fr

# --- Logs ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
